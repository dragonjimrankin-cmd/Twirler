# Copy to `.env` (which is git-ignored) and fill in locally.
# Never commit real values. Never paste real values into chat.

# --- Hatchable ---
# Create at https://hatchable.com/console/settings
HATCHABLE_API_KEY=

# --- Site ---
# Public contact address used by the booking form
PUBLIC_BOOKING_EMAIL=bookings@twirlerpictures.co.uk

# --- Optional integrations (add when you wire them up) ---
# Age-assurance provider
AGE_ASSURANCE_PROVIDER_KEY=
# Payment / membership provider
PAYMENTS_API_KEY=
# Transactional email
SMTP_URL=
